{
  "name": "amalyte-platform",
  "private": true,
  "version": "0.1.0",
  "description": "Amalyte Group — parent + 5 division web properties, monorepo. Design tokens (packages/tokens) are a working baseline, not frozen — expect revisions as the brand system settles.",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "turbo": "^2.10.8",
    "typescript": "^5.6.0"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.25",
      "sharp": "0.35.3",
      "dompurify": "3.4.13",
      "undici": "8.10.0",
      "esbuild": "0.28.1",
      "vite": "^6.4.3",
      "nanoid": "3.3.18"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-w3rx-r6r6-pgpr",
        "GHSA-5p2g-fcmc-qvqq"
      ]
    }
  },
  "packageManager": "pnpm@9.12.0"
}
