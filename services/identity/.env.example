# Copy to .env and fill in real values. Never commit .env.
# Used by docker-compose.yml in this directory.

# Bootstrap admin for the Keycloak admin console (http://localhost:8080/admin)
KC_ADMIN_USERNAME=admin
KC_ADMIN_PASSWORD=change-me

# Password for the bundled Postgres container holding Keycloak's own data
KC_DB_PASSWORD=change-me
