{
  "realm": "amalyte",
  "displayName": "Amalyte",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "verifyEmail": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "failureFactor": 5,
  "defaultSignatureAlgorithm": "RS256",
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "accessTokenLifespan": 900,
  "accessTokenLifespanForImplicitFlow": 0,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 43200,
  "ssoSessionIdleTimeoutRememberMe": 0,
  "ssoSessionMaxLifespanRememberMe": 0,
  "offlineSessionIdleTimeout": 2592000,
  "accessCodeLifespan": 60,
  "accessCodeLifespanUserAction": 300,
  "accessCodeLifespanLogin": 1800,
  "actionTokenGeneratedByAdminLifespan": 43200,
  "actionTokenGeneratedByUserLifespan": 300,
  "oauth2DeviceCodeLifespan": 600,
  "oauth2DevicePollingInterval": 5,
  "passwordPolicy": "length(12) and notUsername and notEmail",
  "webAuthnPolicyRpEntityName": "Amalyte",
  "webAuthnPolicyRpId": "amalyte.com",
  "webAuthnPolicySignatureAlgorithms": ["ES256", "RS256"],
  "webAuthnPolicyAuthenticatorAttachment": "not specified",
  "webAuthnPolicyRequireResidentKey": "not specified",
  "webAuthnPolicyUserVerificationRequirement": "preferred",
  "webAuthnPolicyPasswordlessRpEntityName": "Amalyte",
  "webAuthnPolicyPasswordlessRpId": "amalyte.com",
  "webAuthnPolicyPasswordlessSignatureAlgorithms": ["ES256", "RS256"],
  "webAuthnPolicyPasswordlessAuthenticatorAttachment": "not specified",
  "webAuthnPolicyPasswordlessRequireResidentKey": "Yes",
  "webAuthnPolicyPasswordlessUserVerificationRequirement": "required",
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpSupportedApplications": ["totpAppFreeOTPName", "totpAppGoogleName", "totpAppMicrosoftAuthenticatorName"],
  "roles": {
    "realm": [
      {
        "name": "visitor",
        "description": "Default on registration — gated content, saved items, newsletter prefs (spec §3.5)"
      },
      {
        "name": "lead",
        "description": "Granted by form submission — proposal viewer, quote status (spec §3.5)"
      },
      {
        "name": "client",
        "description": "Manual / CRM sync — project dashboard, deliverables, invoices (spec §3.5)"
      },
      {
        "name": "learner",
        "description": "Course enrolment — course player, progress, certificates (spec §3.5)"
      },
      {
        "name": "instructor",
        "description": "Admin grant — course authoring, cohort management (spec §3.5)"
      },
      {
        "name": "partner",
        "description": "Manual — partner portal, white-label assets, deal reg (spec §3.5)"
      },
      {
        "name": "investor",
        "description": "Manual, time-boxed — confidential decks, data room (spec §3.5)"
      },
      {
        "name": "staff",
        "description": "IdP group — internal tools, all-property admin (spec §3.5)"
      },
      {
        "name": "default-roles-amalyte",
        "description": "Default roles granted on registration — visitor is the baseline role (spec §3.5). Must be defined explicitly here; a separate top-level defaultRole block is ignored on import.",
        "composite": true,
        "composites": {
          "realm": ["visitor", "offline_access", "uma_authorization"],
          "client": {
            "account": ["manage-account", "view-profile"]
          }
        }
      }
    ]
  },
  "clients": [
    {
      "clientId": "parent-web",
      "name": "Amalyte parent site (test client)",
      "description": "Test OIDC client for the Sprint 1 login-flow acceptance check. Public client, authorization code + PKCE only (OAuth 2.1, spec §3.8). One client per property will be modeled when apps wire up packages/auth.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/*",
        "https://amalyte.com/*",
        "https://*.amalyte.com/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "https://amalyte.com",
        "https://*.amalyte.com"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*##https://amalyte.com/*##https://*.amalyte.com/*"
      },
      "protocol": "openid-connect",
      "fullScopeAllowed": true
    },
    {
      "clientId": "auth-cli-test",
      "name": "DEV ONLY — CLI token check",
      "description": "Dev-only client with direct access grants enabled so the Sprint 1 acceptance check (login flow returns a valid JWT) can be verified with curl. MUST be disabled or deleted in any deployed environment.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "fullScopeAllowed": true
    }
  ],
  "authenticationFlows": [
    {
      "alias": "amalyte browser",
      "description": "Browser flow with role-conditional OTP — staff/instructor/partner/investor must complete TOTP MFA (spec §3.8)",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "authenticator": "auth-spnego",
          "requirement": "DISABLED",
          "priority": 20,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "authenticator": "identity-provider-redirector",
          "requirement": "ALTERNATIVE",
          "priority": 25,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "authenticatorFlow": true,
          "requirement": "ALTERNATIVE",
          "priority": 30,
          "flowAlias": "amalyte browser forms",
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "amalyte browser forms",
      "description": "Username/password + conditional MFA subflow",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-username-password-form",
          "requirement": "REQUIRED",
          "priority": 10,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "authenticatorFlow": true,
          "requirement": "CONDITIONAL",
          "priority": 20,
          "flowAlias": "amalyte browser role otp",
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "amalyte browser role otp",
      "description": "OTP required only for privileged roles (staff/instructor/partner/investor), and only once the user has an OTP credential configured",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-user-configured",
          "requirement": "REQUIRED",
          "priority": 10,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "authenticator": "condition-user-role",
          "authenticatorConfig": "privileged roles require OTP",
          "requirement": "REQUIRED",
          "priority": 20,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "authenticator": "auth-otp-form",
          "requirement": "REQUIRED",
          "priority": 30,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "privileged roles require OTP",
      "config": {
        "roles": "[\"staff\",\"instructor\",\"partner\",\"investor\"]"
      }
    }
  ],
  "browserFlow": "amalyte browser",
  "users": [
    {
      "username": "demo.visitor@amalyte.test",
      "email": "demo.visitor@amalyte.test",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Demo",
      "lastName": "Visitor",
      "credentials": [
        {
          "type": "password",
          "value": "ChangeMe!2026",
          "temporary": false
        }
      ],
      "realmRoles": ["visitor"]
    }
  ]
}
